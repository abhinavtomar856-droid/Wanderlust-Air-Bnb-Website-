<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h2 class="show-h2">Listing Details</h2>
            </div>
            <div class="show-card col-6 offset-3">
                <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <p class="card-text">
                        <b>
                            <%=listing.title%>
                        </b><br>
                        <%=listing.description%><br>
                            ₹<%=listing.price.toLocaleString("en-IN")%><br>
                                <%=listing.location%><br>
                                    <%=listing.country%>
                    </p>
                </div>
            </div>
            <div>
                <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit this Listing</a>
                <br><br>
                <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark show-btn">Delete Listing</button>
                </form>
            </div>
        </div>
    </body>